{
  "name": "threejs-game-engine",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run build:player",
    "build": "tsc --noEmit && vite build",
    "prebuild": "npm run build:player",
    "build:player": "vite build --config vite.player.config.ts --logLevel warn && vite build --config vite.player.config.ts --mode webgpu --logLevel warn",
    "preview": "vite preview",
    "server": "bun server/files.ts",
    "start": "bun server/files.ts --static",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server",
    "test": "vitest run",
    "test:server": "bun test ./server",
    "test:e2e": "node e2e/smoke.mjs",
    "test:exports": "node e2e/exports.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "meshoptimizer": "^1.3.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^29.1.1",
    "playwright": "1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
